// Root mirror of backend/prisma/schema.prisma
// For root-level reference and documentation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiriesCreated    Enquiry[]
  quotationsCreated   Quotation[]
  ordersConfirmed     SalesOrder[]  @relation("OrderConfirmedBy")
  dispatchesHandled   Dispatch[]    @relation("OrderDispatchedBy")

  @@index([email])
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String   @unique
  city          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]

  @@index([companyName])
  @@index([email])
}

model Product {
  id          String   @id @default(uuid())
  productCode String   @unique
  productName String
  category    String
  unit        String
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory   Inventory?

  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@index([productCode])
  @@index([category])
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
}

model Enquiry {
  id            String        @id @default(uuid())
  enquiryNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime?
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         EnquiryItem[]
  quotations    Quotation[]

  @@index([enquiryNumber])
  @@index([customerId])
  @@index([status])
}

model EnquiryItem {
  id          String   @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  targetPrice Decimal? @db.Decimal(12, 2)

  @@index([enquiryId])
  @@index([productId])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique
  enquiryId          String?
  enquiry            Enquiry?        @relation(fields: [enquiryId], references: [id])
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  createdById        String
  createdBy          User            @relation(fields: [createdById], references: [id])
  validUntil         DateTime
  status             QuotationStatus @default(DRAFT)
  
  subtotal           Decimal         @db.Decimal(12, 2)
  discountPercentage Decimal         @default(0.00) @db.Decimal(5, 2)
  discountAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  taxPercentage      Decimal         @default(18.00) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal         @db.Decimal(12, 2)
  
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items              QuotationItem[]
  salesOrder         SalesOrder?

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id            String           @id @default(uuid())
  orderNumber   String           @unique
  quotationId   String           @unique
  quotation     Quotation        @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  orderDate     DateTime         @default(now())
  status        SalesOrderStatus @default(PENDING)
  totalAmount   Decimal          @db.Decimal(12, 2)
  
  confirmedById String?
  confirmedBy   User?            @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items         SalesOrderItem[]
  dispatch      Dispatch?

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)

  @@index([salesOrderId])
  @@index([productId])
}

model Dispatch {
  id             String     @id @default(uuid())
  dispatchNumber String     @unique
  salesOrderId   String     @unique
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  dispatchDate   DateTime   @default(now())
  vehicleNumber  String
  driverName     String
  notes          String?
  dispatchedById String
  dispatchedBy   User       @relation("OrderDispatchedBy", fields: [dispatchedById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items          DispatchItem[]

  @@index([dispatchNumber])
  @@index([salesOrderId])
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([dispatchId])
  @@index([productId])
}
