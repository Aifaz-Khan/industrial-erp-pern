{
  "info": {
    "_postman_id": "industrial-erp-postman-collection",
    "name": "Industrial ERP API",
    "description": "Postman API Collection for Industrial B2B Manufacturing & Supply Chain ERP Placement Technical Case Study",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "Health Telemetry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks server uptime, memory usage, and operational status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-extract JWT and save to environment variable",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved Admin token to environment variable 'token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@industrial-erp.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates ADMIN and automatically stores JWT token in environment."
          },
          "response": []
        },
        {
          "name": "2. Login as Sales",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-extract JWT and save to environment variable",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved Sales token to environment variable 'token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@industrial-erp.com\",\n  \"password\": \"SalesPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates SALES user and stores JWT token in environment."
          },
          "response": []
        },
        {
          "name": "3. Get Current User Profile (GET /api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieves the currently authenticated user's sanitized profile."
          },
          "response": []
        },
        {
          "name": "4. Verify Admin-Only Route (RBAC Check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/admin-only",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin-only"]
            },
            "description": "Returns 200 for ADMIN, and 403 Forbidden if accessed with a SALES token."
          },
          "response": []
        }
      ]
    }
  ]
}
