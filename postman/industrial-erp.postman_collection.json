{
  "info": {
    "_postman_id": "industrial-erp-postman-collection",
    "name": "Industrial ERP API",
    "description": "Postman API Collection for Industrial B2B Manufacturing & Supply Chain ERP Placement Technical Case Study",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "Health Telemetry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved Admin token to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@industrial-erp.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "2. Login as Sales",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Saved Sales token to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@industrial-erp.com\",\n  \"password\": \"SalesPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Current User Profile (GET /api/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "4. Verify Admin-Only Route (RBAC Check)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/admin-only",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin-only"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "1. Get All Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Inventory Stock Overview (Physical, Reserved, Available)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["inventory"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "1. Get All Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          },
          "response": []
        },
        {
          "name": "2. Create New Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Larsen & Turbo Heavy Systems\",\n  \"contactPerson\": \"Vikram Malhotra\",\n  \"mobile\": \"+91 98220 11223\",\n  \"email\": \"vikram@lnt-heavy.com\",\n  \"city\": \"Vadodara\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enquiries",
      "item": [
        {
          "name": "1. Create Customer Enquiry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"810f49d1-fd10-4a3e-88c4-2d7d6a56d3ea\",\n  \"requiredDate\": \"2026-10-30\",\n  \"notes\": \"Requirement for plant expansion unit #3\",\n  \"items\": [\n    {\n      \"productId\": \"00c45d93-37f9-4d20-8057-d3516f85ace7\",\n      \"quantity\": 5,\n      \"targetPrice\": 18000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get All Enquiries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Enquiry by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/enquiries/:id",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries", ":id"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Quotations",
      "item": [
        {
          "name": "1. Create Quotation (Calculates Subtotal, GST, Grand Total Server-Side)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"810f49d1-fd10-4a3e-88c4-2d7d6a56d3ea\",\n  \"enquiryId\": null,\n  \"validUntil\": \"2026-11-30\",\n  \"discountPercentage\": 10,\n  \"taxPercentage\": 18,\n  \"notes\": \"Commercial terms: 30 days credit\",\n  \"items\": [\n    {\n      \"productId\": \"00c45d93-37f9-4d20-8057-d3516f85ace7\",\n      \"quantity\": 4,\n      \"unitPrice\": 18500\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["quotations"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.quotation) {",
                  "    pm.environment.set(\"quotationId\", jsonData.data.quotation.id);",
                  "    console.log(\"Auto-saved quotationId to environment:\", jsonData.data.quotation.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Get All Quotations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["quotations"]
            }
          },
          "response": []
        },
        {
          "name": "3. Update Quotation Status (DRAFT -> SENT -> ACCEPTED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations/{{quotationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", "{{quotationId}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sales Orders & Dispatch",
      "item": [
        {
          "name": "1. Convert Accepted Quotation to Sales Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.order) {",
                  "    pm.environment.set(\"orderId\", jsonData.data.order.id);",
                  "    console.log(\"Auto-saved orderId to environment:\", jsonData.data.order.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/quotations/{{quotationId}}/convert",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", "{{quotationId}}", "convert"]
            },
            "description": "Converts an ACCEPTED quotation into a Sales Order with PENDING status. Rejects DRAFT or REJECTED quotes."
          },
          "response": []
        },
        {
          "name": "2. Get All Sales Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-orders",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Sales Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{orderId}}"]
            }
          },
          "response": []
        },
        {
          "name": "4. Confirm Sales Order & Reserve Inventory (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{orderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{orderId}}", "confirm"]
            },
            "description": "ADMIN only: Checks available stock, locks row using PostgreSQL FOR UPDATE, increments reserved stock, sets status to CONFIRMED."
          },
          "response": []
        },
        {
          "name": "5. Dispatch Confirmed Sales Order (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"MH-12-AB-9876\",\n  \"driverName\": \"Ramesh Patil\",\n  \"notes\": \"Dispatched via express road logistics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{orderId}}/dispatch",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{orderId}}", "dispatch"]
            },
            "description": "ADMIN only: Decrements both physical and reserved stock counts, records vehicle/driver details, sets status to DISPATCHED."
          },
          "response": []
        },
        {
          "name": "6. Cancel Sales Order & Release Stock (ADMIN Only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{orderId}}", "cancel"]
            },
            "description": "ADMIN only: Cancels order and releases reserved stock back into available inventory."
          },
          "response": []
        }
      ]
    }
  ]
}
