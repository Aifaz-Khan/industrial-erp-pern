# Application Environment Variables Example

# Backend Server Configuration
# Note: Port 5001 is used by default because macOS Monterey+ reserves port 5000 for AirPlay Receiver.
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Neon / AWS RDS / Local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/industrial_erp?schema=public"

# Authentication Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=24h

# Frontend API Base URL (must match the backend PORT)
VITE_API_BASE_URL=http://localhost:5001/api
